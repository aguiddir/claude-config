{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "dark",
  "includeGitInstructions": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/PycharmProjects/harnais/plugins/harnais/hooks/github-signature.mjs\"; [ ! -f \"$f\" ] || CLAUDE_PLUGIN_OPTION_GITHUB_SIGNATURE='🤖 Claude pour aguiddir' node \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
